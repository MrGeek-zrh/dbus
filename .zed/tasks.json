// Static tasks configuration.
//
// Example:
[
  {
    "label": "build-dbus",
    "command": "bash $ZED_WORKTREE_ROOT/scripts/build.sh",
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "restart-dbus",
    "command": "bash $ZED_WORKTREE_ROOT/scripts/check.sh",
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "print_dbus_daemon_pid",
    "command": "bash $ZED_WORKTREE_ROOT/scripts/get_dbus_daemon_pid.sh",
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "rebuild-dbus",
    "command": "echo 'Rebuild sequence started' && bash $ZED_WORKTREE_ROOT/scripts/build.sh && bash $ZED_WORKTREE_ROOT/scripts/check.sh && bash $ZED_WORKTREE_ROOT/scripts/get_dbus_daemon_pid.sh",
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
